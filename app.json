{
  "expo": {
    "name": "STR",
    "slug": "str",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "str",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C0C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nickbuilds.str",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "STR uses your photo library so you can add a progress photo to your workout session and set your profile picture. For example, after a big PR you can attach a gym photo to that workout entry.",
        "NSCameraUsageDescription": "STR uses your camera so you can take a progress photo directly during a workout session or update your profile picture in real time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0C0C"
      },
      "package": "com.nickbuilds.str"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "STR uses your photo library to let you choose a profile photo. For example, you can select a photo of yourself to display on your profile and to friends in the social feed."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF4500",
          "sounds": [],
          "iosDisplayInForeground": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0C",
          "image": "./assets/splash.png"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-camera",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ac81fe2e-db5d-49c2-8957-428086c1b8fb"
      }
    },
    "owner": "beastyvass-organization"
  }
}
