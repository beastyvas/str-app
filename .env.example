EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ANTHROPIC_API_KEY is set as a Supabase Edge Function secret only
# (supabase secrets set ANTHROPIC_API_KEY=...) — never as an EXPO_PUBLIC_ var,
# since those get bundled straight into the client app.
